# Azure DevOps
AZURE_DEVOPS_PAT=your_personal_access_token
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-org
AZURE_DEVOPS_PROJECT=your-project-name

# LLM Provider: "ollama" or "azure_openai"
LLM_PROVIDER=azure_openai

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_key
AZURE_OPENAI_DEPLOYMENT=gpt-5-nano
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# Git
# Container içinde: /workspace/target-repo (docker-compose volume)
# Lokal geliştirme: C:/repos/target-repo
GIT_REPO_PATH=/workspace/target-repo
GIT_REMOTE_URL=https://dev.azure.com/your-org/your-project/_git/your-repo

# App
WEBHOOK_SECRET=your_webhook_secret
LOG_LEVEL=INFO
PORT=8000
